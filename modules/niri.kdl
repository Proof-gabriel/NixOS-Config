// ============================================================
// NIRI CONFIGURATION
// Organizado em blocos detalhados
// ============================================================

// ============================================================
// 1. DISPOSITIVOS DE ENTRADA (TECLADO E MOUSE)
// ============================================================
input {
    keyboard {
        xkb {
            layout "br"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        click-method "clickfinger" // 2 dedos = botão direito, 3 dedos = meio
        dwt                        // Evita cliques acidentais ao digitar
        accel-profile "adaptive"   // Curva orgânica para o movimento do mouse
    }

    // Foco segue o mouse ao passar pelas janelas (sem scroll automático indesejado)
    focus-follows-mouse max-scroll-amount="0%"
    // --- MUDANÇA AQUI ---
    // Foco segue o mouse de forma pura e imediata
   }


// ============================================================
// 2. LAYOUT E APARÊNCIA DA FITA
// ============================================================
layout {
    // Espaçamento entre as janelas
    gaps 5

    // Define que a janela focada não precisa ir para o centro da tela se couber
    center-focused-column "never"

    // Proporções padrões das janelas (1/3, Metade e 2/3 da tela)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Largura padrão ao abrir uma nova janela
    default-column-width { proportion 0.5; }

    // Desativa a borda de foco padrão do Niri
    focus-ring {
        off
    }

    // Desativa a borda colorida da janela
    border {
        off
    }
}


// ============================================================
// 3. INICIALIZAÇÃO (AUTOSTART)
// ============================================================
// Suporte a aplicativos X11 (legados)
spawn-at-startup "xwayland-satellite"

// Interface e Shell
spawn-at-startup "noctalia"

// Papel de parede
spawn-at-startup "wpaperd"


// ============================================================
// 4. ANIMAÇÕES
// ============================================================
animations {
    // Você pode descomentar a linha abaixo para deixar as animações mais lentas/suaves
    // slowdown 3.0
}


// ============================================================
// 5. REGRAS DE JANELAS (WINDOW RULES)
// ============================================================

// --- Visual Orgânico Global ---
// Aplica bordas arredondadas a todas as janelas do sistema
window-rule {
    geometry-corner-radius 12.0
    clip-to-geometry true
}

// --- Regra GLOBAL para Picture-in-Picture (PiP) ---
// Funciona para Zen, Brave, Firefox, etc.
window-rule {
    // O modificador (?i) ignora letras maiúsculas/minúsculas
    match title=r#"(?i)^picture-in-picture$"#
    match title=r#"(?i)^picture in picture$"#

    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-left"
}


// ============================================================
// 6. ATALHOS DO TECLADO E SISTEMA (BINDS)
// ============================================================
binds {
    // Exibe a tela de ajuda com todos os atalhos
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --------------------------------------------------------
    // APLICATIVOS PRINCIPAIS
    // --------------------------------------------------------
    Mod+Space  { spawn-sh "noctalia msg panel-toggle launcher"; } // Menu
    Mod+T      { spawn "ghostty"; }                               // Terminal principal
    Mod+Return { spawn "ghostty"; }                               // Terminal reserva
    Mod+B      { spawn "brave"; }                                 // Navegador
    Mod+Alt+L  { spawn "swaylock"; }                              // Bloqueio de tela

    // --------------------------------------------------------
    // CONTROLES DE MÍDIA E BRILHO
    // --------------------------------------------------------
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.5"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop         allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // --------------------------------------------------------
    // GERENCIAMENTO DA JANELA ATUAL
    // --------------------------------------------------------
    Mod+Q       { close-window; }
    Mod+O       { toggle-overview; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }

    // --------------------------------------------------------
    // FOCO (NAVEGAR ENTRE JANELAS - Mod)
    // --------------------------------------------------------
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }

    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-workspace-up; }
    Mod+J     { focus-workspace-down; }

    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // --------------------------------------------------------
    // MOVER JANELAS E COLUNAS (Mod + Shift)
    // --------------------------------------------------------
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Down  { move-column-to-workspace-down; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-column-to-workspace-up; }
    Mod+Shift+J     { move-column-to-workspace-down; }

    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    // --------------------------------------------------------
    // WORKSPACES (ÁREAS DE TRABALHO)
    // --------------------------------------------------------
    // Navegar nos workspaces
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+1         { focus-workspace 1; }
    Mod+2         { focus-workspace 2; }
    Mod+3         { focus-workspace 3; }
    Mod+4         { focus-workspace 4; }

    // Enviar a coluna atual para outro workspace
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Ctrl+1         { move-column-to-workspace 1; }
    Mod+Ctrl+2         { move-column-to-workspace 2; }
    Mod+Ctrl+3         { move-column-to-workspace 3; }
    Mod+Ctrl+4         { move-column-to-workspace 4; }

    // --------------------------------------------------------
    // NAVEGAÇÃO POR SCROLL DO MOUSE
    // --------------------------------------------------------
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // --------------------------------------------------------
    // MANIPULAÇÃO DO LAYOUT DA FITA
    // --------------------------------------------------------
    Mod+Comma   { consume-window-into-column; }
    Mod+Period  { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }

    Mod+C       { center-column; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // --------------------------------------------------------
    // CAPTURA DE TELA (Estilo macOS)
    // --------------------------------------------------------
    Mod+Shift+3 { screenshot-screen; } // Cmd+Shift+3: Tela inteira
    Mod+Shift+4 { screenshot; }        // Cmd+Shift+4: Selecionar área
    Mod+Shift+5 { screenshot-window; } // Cmd+Shift+5: Janela atual

    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // --------------------------------------------------------
    // SESSÃO E ENERGIA
    // --------------------------------------------------------
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}

// ============================================================
// 7. INCLUDES ESPECIAIS
// ============================================================
include "noctalia.kdl"
